{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=index.js --external:@prisma/client --footer:js=\"module.exports = module.exports.default || module.exports;\"",
    "start": "node index.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "seed": "tsx src/seeds/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "esbuild": "^0.28.2",
    "prisma": "6.19.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}